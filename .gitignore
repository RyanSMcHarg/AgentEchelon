# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.d.ts

# CDK
cdk.out/
*.js
!jest.config.js
!vite.config.js
!eslint.config.js

# Lambda handler source files (CommonJS, not compiled output)
!backend/lambda/*/index.js
!backend/lambda/*/*/index.js
!backend/lambda/cognito-triggers/*.js

# Keep TypeScript source
!*.ts

# Environment
#
# BROAD ON PURPOSE, and the narrow version is what let a gap stand. Listing `.env`, `.env.local` and
# `.env.*.local` covered exactly three spellings, so `.env.production` and `.env.development` - Vite's
# OWN convention, and therefore the likeliest names for a file holding real deployment values - were
# neither ignored here nor blocked by the pre-commit hook. The remote is public, so the cost of the
# miss is unrecoverable and the cost of being broad is one negation.
#
# The example templates are the one thing that must stay tracked: they carry placeholders only, and
# every deployment starts by copying one.
.env*
!.env.example

# CDK — never commit the lookup cache (account-specific: account IDs, VPC/subnet IDs
# from fromLookup) or synth output.
cdk.context.json
cdk.out/
*.cdk.staging

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Playwright artifacts (generated per run)
test-results/
playwright-report/
tests/demo-output/
# Ad-hoc operator inspection artifacts (gunzipped archive samples, lambda
# response captures, IAM role dumps) - these are temporary and should
# never land in git.
tests/*.gz
tests/*.json
!tests/package*.json
!tests/playwright.config.json
!tests/tsconfig*.json

# Misc
# .claude/ — local Claude Code state is gitignored, but the checked-in
# pieces (hooks, project settings, slash commands) ship to all
# contributors and OSS users.
.claude/*
!.claude/hooks/
!.claude/commands/
!.claude/settings.json
# Hooks may include JS scripts — bypass the project-wide *.js ignore
# (line ~12 above) just for those.
!.claude/hooks/*.js
.obsidian/
.stfolder*/

# Obsidian / Syncthing working directories
AI Agent/

# local throwaway probe/verify scripts (untracked)
backend/*.mjs

# Scratch / working directory (reflow tooling, spec backups, ad-hoc dumps)
tmp/

# Private session working files (plans, bug trackers, handoffs, consolidation notes)
# and assistant memory — never part of the public repo. Kept out of a fresh checkout.
HANDOFF-*.md
HANDOVER-*.md
PLAN-*.md
BUGS-*.md
DOC-CONSOLIDATION-*.md
# TRACKER-*.md is the DURABLE, append-only record of open work. Unlike a HANDOVER (a per-session
# snapshot that gets rewritten, so a true-but-incomplete item silently reads as done next session),
# a tracker row is only removed when the work is verified complete. Never pushed to origin.
TRACKER-*.md
# Review-run working artifacts (finding lists that drive tracker rows). Same rule as the tracker:
# working records, never pushed to origin.
.review-findings.json
memory/

# Per-instance deploy context (account-specific: AWS account id, app instance, pool ids).
# The glob covers the backups the teardown/redeploy flow leaves behind (`.bak-preteardown`,
# `.bak-<date>`), which carry the same identifiers as the file itself. Ignoring only the exact
# name left those siblings untracked-but-not-ignored, so one `git add -A` would publish them.
deploy.config.json
deploy.config.json.*
# Deployer-owned context source catalog (SPEC-CONTEXT-SOURCE-CATALOG). Copy
# lib/config/context-sources.example.ts to context-sources.local.ts and edit that,
# so upgrading the tracked example never conflicts with your customization.
backend/lib/config/context-sources.local.ts
backend/lib/config/context-sources.local.js
backend/lib/config/context-sources.local.d.ts

# Codex CLI local config — its hook uses a machine-specific absolute path, so it
# is local-only (unlike .claude/, whose hooks are portable and checked in).
.codex/

# Local-only coverage matrix (generated by reading the repo, not tracked).
COVERAGE-MATRIX.local.md
PLAN-TEST-SOLIDIFICATION.local.md
HANDOFF-TEST-SOLIDIFICATION.local.md

# Exclusive lock held for the lifetime of a heavy test run (backend/scripts/lib/test-run-lock.cjs).
# Runtime state naming a live pid on one machine, so it is never shared. A stale one - left by a
# crash or a hard kill - is reclaimed automatically on the next run; deleting it by hand is safe
# once no jest process is running.
.test-run.lock
# Rebuilds the gitignored tracker INDEX from the tracker DETAIL file. Private-workflow tooling that
# reads private files, so it is ignored alongside them (the TRACKER-*.md rule above covers the docs
# themselves, not this).
TRACKER-*.mjs
