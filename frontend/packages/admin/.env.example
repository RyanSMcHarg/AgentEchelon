# AWS Configuration
VITE_AWS_REGION=us-east-1

# Cognito Configuration
VITE_USER_POOL_ID=your-user-pool-id
VITE_CLIENT_ID=your-client-id
# The app client a provider federated into the pool signs in through (UserPoolFederatedClientId); only when one is.
VITE_FEDERATED_CLIENT_ID=
# Redirect sign-in issuers (authorization code with PKCE), written by
# backend/scripts/gen-frontend-env.mjs from the trusted-issuer registry
# (the issuers key of deploy.config.json): public fields only. Unset or [] means
# password sign-in only. The issuer returns to <this origin>/callback.
# VITE_ISSUERS='[]'

# The person API (PersonApi), REQUIRED. Every route a person calls, at the API
# root: the credential exchange (SPEC-CREDENTIAL-EXCHANGE, the only source of
# Amazon Chime SDK credentials, so the app cannot reach the Amazon Chime SDK if
# this is unset), conversations, tasks, turn state, attachments, feedback, client
# events, and the optional battle and sharing routes. CDK output
# AgentEchelonPersonApi.PersonApiUrl.
VITE_PERSON_API_URL=https://<id>.execute-api.<region>.amazonaws.com/
# The capabilities whose person routes PersonApi serves, comma-separated. CDK
# output AgentEchelonPersonApi.PersonApiCapabilities. `core` is always served;
# the battle UI exists only when this names `battle`, sharing only when it
# names `notifications`.
VITE_PERSON_API_CAPABILITIES=core

# The admin API (AdminApi), admin console only, never the chat bundle. Every
# admin route: the admin credential exchange (console sessions, per-capability
# admin vends, the access log), admin conversations, analytics (mounted at
# /query), user management, profiles, ownership, the roster, experiments and
# the feedback summary. CDK output AgentEchelonAdminApi.AdminApiUrl.
VITE_ADMIN_API_URL=https://<id>.execute-api.<region>.amazonaws.com/
# The capabilities whose admin routes AdminApi serves, comma-separated. CDK
# output AgentEchelonAdminApi.AdminApiCapabilities. Experiment administration
# (the Experiments section) exists only when this names `experiments`.
VITE_ADMIN_API_CAPABILITIES=admin

# Chime SDK Configuration
VITE_APP_INSTANCE_ARN=your-app-instance-arn
# (No bot ARN is needed here — channels enroll the per-tier bot server-side via create-conversation.)

# Whether cost sleep mode is deployed. Source: CDK output
# AgentEchelonArchive.SleepModeEnabled. Only when 'true' does the
# DeploymentStatusBanner poll GET /deployment/state on the person API; otherwise
# that route does not exist and polling it would 403 on every tick. Absent ⇒
# treated as off.
VITE_SLEEP_MODE_ENABLED=false

# Analytics mode: 'athena' (default) or 'aurora' (enables advanced admin tabs)
# If not set, auto-detected by probing the backend endpoint
# VITE_ANALYTICS_MODE=athena
