# The embeddable widget's build env. Written by backend/scripts/gen-frontend-env.mjs from the deployed
# stack outputs and the trusted-issuer registry (deploy.config.json `issuers`) when `widget` is a
# declared capability. Do not commit the generated .env.

VITE_AWS_REGION=us-east-1
# The Amazon Chime SDK app instance. CDK output AppInstanceArnOutput.
VITE_APP_INSTANCE_ARN=your-app-instance-arn
# The person API (PersonApi), REQUIRED: guest start, guest refresh and the credential exchange.
# CDK output PersonApiUrl.
VITE_PERSON_API_URL=https://<id>.execute-api.<region>.amazonaws.com/
# The guest issuer, when the registry declares one: the captcha site key the widget loads at guest
# start (CDK output GuestCaptchaSiteKey) and the privacy-notice version it shows (GuestNoticeVersion).
# Unset: the widget offers no guest start.
VITE_GUEST_CAPTCHA_SITE_KEY=
VITE_GUEST_NOTICE_VERSION=
# How a visit becomes an account: the upgrade paths the visitor's conversation type declares (bind,claim;
# CDK output GuestUpgradePaths) and the chat app the visitor signs in at (GuestSignInUrl). Unset: the
# widget offers no way to keep the visit.
VITE_GUEST_UPGRADE_PATHS=
VITE_GUEST_SIGN_IN_URL=
# The origins a host assertion may be posted from: every `allowedOrigins` of the registry's
# host-assertion entries, comma-separated. Unset: the widget accepts no host assertion.
VITE_WIDGET_ASSERTION_HOSTS=
