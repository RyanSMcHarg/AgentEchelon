{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/serial-test-runs.js"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/doc-context.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/reuse-first.js"
          }
        ]
      }
    ]
  }
}
